# Copy to shim/.env (or your service's EnvironmentFile) and fill in.
VAST_API_KEY=
# Same as endpoint.name, model.served_name and embedding.served_name in deploy/config.toml.
ENDPOINT_NAME=pantheon
SERVED_MODEL_NAME=pantheon
# Leave empty if config.toml has no [embedding] section.
EMBED_MODEL_NAME=qwen3-embedding
# For deploy/config.waifugemma4.example.toml: ENDPOINT_NAME=waifugemma4 and
# SERVED_MODEL_NAME=waifugemma4 (EMBED_MODEL_NAME stays the same).

SHIM_HOST=0.0.0.0
SHIM_PORT=8787
# Clients must send "Authorization: Bearer <this>" when set. Set it if the port
# is reachable from anything but this machine.
SHIM_API_KEY=

# How long a request may wait for a worker (cold start included), seconds.
REQUEST_TIMEOUT=1800
# Longest a non-streaming generation may take once it reaches a worker.
WORKER_TIMEOUT=900
# Keepalive while waiting: SSE comments when streaming, spaces before the JSON
# body otherwise. Set NONSTREAM_KEEPALIVE=0 if a client rejects leading spaces.
KEEPALIVE_INTERVAL=10
NONSTREAM_KEEPALIVE=1
# Worker 5xx/429 retries before the error is returned.
MAX_RETRIES=3
LOG_LEVEL=INFO

# Warm hours: keep one worker awake during these local times, so the first
# request of an evening doesn't wait for a cold start. Off when empty.
# HH:MM-HH:MM, comma-separated; may cross midnight. A cold start takes about
# 25 min, so start the window that much before you need it. While on, a
# worker bills its full $/hr (a 3090 at about $0.17/hr: about $1.40 for 8 h).
# Pings go to the embedding model (EMBED_MODEL_NAME), so they don't touch the
# chat model's prompt cache. Without one they use the chat model and can push
# a conversation's cached prompt out of its slot.
WARM_HOURS=
# e.g. 14:30-23:00
# Time zone for WARM_HOURS (IANA name, e.g. America/Chicago). In Docker the
# machine clock is usually UTC, so set this.
WARM_TZ=
# Seconds between pings while warm; must stay under the endpoint's
# inactivity_timeout (900 in the example configs).
WARM_PING_S=300
